{
  "name": "zoho-people-automation",
  "version": "1.0.0",
  "description": "Automated check-in/check-out and weekly timesheet processing for Zoho People",
  "main": "src/checkin.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "checkin": "node src/checkin.js --action checkin",
    "checkout": "node src/checkin.js --action checkout",
    "checkin:dry": "node src/checkin.js --action checkin --dry-run",
    "checkout:dry": "node src/checkin.js --action checkout --dry-run",
    "timesheet": "node src/timesheet.js",
    "timesheet:dry": "node src/timesheet.js --dry-run",
    "timesheet:catchup": "node src/timesheet.js --catchup"
  },
  "keywords": [
    "zoho",
    "zoho-people",
    "automation",
    "attendance",
    "timesheet",
    "checkin"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^4.6.0"
  }
}
