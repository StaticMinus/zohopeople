# Zoho API OAuth 2.0 Credentials
# Obtain these from https://api-console.zoho.com/
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Zoho Region Domains (default to .com, adjust if using .eu, .in, .com.au, .ca)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_PEOPLE_URL=https://people.zoho.com

# Employee Information
ZOHO_EMP_ID=1001
ZOHO_EMP_EMAIL=user@company.com

# Attendance Settings
DEFAULT_CHECKIN_TIME=09:00
DEFAULT_CHECKOUT_TIME=17:00
# Random jitter in minutes (e.g. 5 means check-in between 8:55 AM and 9:05 AM)
JITTER_MINUTES=5

# Timesheet Settings
# Default daily work hours logged per weekday
TIMESHEET_WORK_HOURS=8.0
# Optional: Project ID and Job ID / Task Name in Zoho Time Tracker
TIMESHEET_PROJECT_ID=
TIMESHEET_JOB_NAME=Project - RAN
TIMESHEET_BILLABLE_STATUS=Non-Billable

# Cloud / Hosting Settings
TIMEZONE=Africa/Lagos
CRON_SECRET=your-secure-random-secret-key-for-webhooks

# Geolocation Settings (Enugu, Nigeria)
ATTENDANCE_LATITUDE=6.4527
ATTENDANCE_LONGITUDE=7.5103
ATTENDANCE_LOCATION=Enugu, Nigeria
